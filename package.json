{
  "name": "labspace-ai-agent-twin",
  "version": "0.1.0",
  "description": "A browser-agent-ready laboratory spatial twin for design, indexing, audit, and exact-location workflows.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:e2e": "cross-env PORT=3104 LABSPACE_DB_PATH=data/labspace-e2e.sqlite LABSPACE_DISABLE_HMR=1 node --import tsx server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts --production",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:e2e:webmcp": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright test tests/e2e/webmcp-actions.spec.ts",
    "validate:assets": "tsx scripts/validate-assets.ts",
    "release:check": "npm run lint && npm run typecheck && npm run validate:assets && npm run test && npm run build",
    "assets:build": "node scripts/build-hero-assets.mjs",
    "assets:render-procedural": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 tsx scripts/render-procedural-assets.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@vitejs/plugin-react": "5.0.4",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "konva": "^10.3.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-konva": "^19.2.5",
    "three": "^0.185.1",
    "vite": "6.4.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10",
    "webmcp-types": "^0.1.5"
  }
}
